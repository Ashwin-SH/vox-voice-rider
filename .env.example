# VOX runs fully WITHOUT any keys (keyless demo mode uses the browser Web Speech API).
# Add a FREE Google AI Studio key to let the server use Gemini for smarter
# natural-language understanding of speech. Get one at https://aistudio.google.com (no card).
GEMINI_API_KEY=

# Postgres (defaults match docker-compose.yml; no need to change for local)
DATABASE_URL=postgres://vox:vox@db:5432/vox
